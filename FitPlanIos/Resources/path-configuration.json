{
  "settings": {},
  "rules": [
    { "patterns": ["/new$", "/edit$", "/sign_in$", "/strada-form$"], "properties": { "context": "modal", "pull_to_refresh_enabled": false } },
    { "patterns": ["^/?$", "^/sheets$", "^/sheets/shares$", "^/dashboard$", "^/social/profiles$", "^/identity/profile$", "/welcome$"], "properties": { "presentation": "replace_root" } },
    { "patterns": ["/numbers$"], "properties": { "view_controller": "numbers" } },
    { "patterns": ["/welcome$", "/sign_in$", "/sign_up$", "/identity/password_reset", "/auth/failure$"], "properties": { "tab_bar": "hidden" } }
  ]
}
